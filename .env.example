# Choose provider: mock | openai | openrouter | ollama | gemini | anthropic
LLM_PROVIDER=mock

# Model name (provider-specific)
# Examples:
#   gemini: gemini-2.5-flash
#   openai: gpt-4o-mini
#   openrouter: google/gemini-2.5-flash
#   ollama: llama3.1
#   anthropic: claude-3-5-sonnet-latest
LLM_MODEL=mock-ps1-v1

# API key (not required for mock or local ollama)
LLM_API_KEY=

# Optional custom base URL (for OpenAI-compatible endpoints: OpenRouter, Groq, Ollama, vLLM)
# Examples:
#   https://openrouter.ai/api/v1
#   http://localhost:11434/v1
LLM_BASE_URL=

# Generation settings
LLM_TEMPERATURE=0.9
LLM_TIMEOUT_SECONDS=60.0
LLM_MAX_RETRIES=2

# Directory for exported episodes
OUTPUT_DIR=output
